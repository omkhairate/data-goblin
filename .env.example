# Required. This makes accidental paid bookings harder.
AUTO_BOOK_1GB=false

# Required for automatic re-login. Store the password with `npm run credentials`.
WINSIM_USERNAME=

# The winSIM page to monitor.
WINSIM_TARGET_URL=https://service.winsim.de/mytariff/invoice/showServicesAndOptions

# Polling and safety limits.
CHECK_INTERVAL_MS=5000
LOGIN_MAX_ATTEMPTS=4
MANUAL_ATTENTION_REMINDER_MS=120000

# Keep false if you want to watch what happens.
HEADLESS=false

# Optional. If winSIM opens a second confirmation page/dialog after "Buchen",
# set this only after verifying the wording yourself.
CONFIRM_BOOKING=false
